# CMDBuild connection
CMDBUILD_BASE_URL=https://cmdbuild.example.com
CMDBUILD_API_PATH=/api
CMDBUILD_TOKEN=change-me

# Mapping
CMDBUILD_CLASS_NAME=Server
CMDBUILD_UNIQUE_KEY=hostname

# Sync behavior
CMDBUILD_DRY_RUN=false
CMDBUILD_CREATE_MISSING=true
CMDBUILD_UPDATE_EXISTING=true
CMDBUILD_RETRY_COUNT=3
CMDBUILD_RETRY_SLEEP_SECONDS=5
